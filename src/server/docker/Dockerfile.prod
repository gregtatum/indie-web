FROM node:24

WORKDIR /app

# The build.context is assumed to be the repo's root directory.
COPY src/server/package.json ./src/server/package.json
COPY src/server/package-lock.json ./src/server/package-lock.json

WORKDIR /app/src/server
RUN npm ci

WORKDIR /app
COPY src/server ./src/server
COPY src/shared ./src/shared

WORKDIR /app/src/server
ENV NODE_ENV=production

# Mirrors package.json's "start" script, invoked directly instead of via
# `npm run start` so node is PID 1 and receives signals like SIGTERM
# directly (npm doesn't reliably forward them to the process it spawns).
# Keep this in sync with the "start" script in src/server/package.json.
CMD ["node", "--disable-warning=ExperimentalWarning", "."]
